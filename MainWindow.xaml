<Window x:Class="PlayMe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayMe" Width="336" Height="146"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F3F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9DA2B4"/>
        <SolidColorBrush x:Key="Accent" Color="#3BC8D6"/>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CornerButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Opacity" Value="0.35"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="14" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource Accent}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRestButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="14" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="10" Height="10" Fill="#F2F3F7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="3" CornerRadius="1.5" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFillButton}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRestButton}"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VolThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="8" CornerRadius="14" Background="#F5191A21"
            BorderBrush="#28FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="TopmostMenuItem" Header="Always on top" IsCheckable="True" IsChecked="True"
                          Click="TopmostMenuItem_Click"/>
                <MenuItem Header="Player" Click="VideoButton_Click"
                          ToolTip="Open sites in a panel that follows you across desktops"/>
                <MenuItem Header="Mixer" Click="MixerButton_Click"
                          ToolTip="Volume for every app that makes sound, including games"/>
                <MenuItem Header="Open Amazon Music" Click="OpenAmazonMusic_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- album art -->
                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="10" Background="#232530"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource Glyph}" Text="&#xE93C;"
                                   FontSize="26" Foreground="{StaticResource TextSecondary}"/>
                        <Border x:Name="ArtImageHost" CornerRadius="10" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <!-- track info + transport + volume + progress -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText" Grid.Row="0" Text="Nothing playing"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>
                    <TextBlock x:Name="ArtistText" Grid.Row="1" Text="Play something on Amazon Music"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,20,0"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,1">
                        <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Click="Prev_Click"
                                ToolTip="Previous">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="13"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}"
                                Width="34" Height="34" Margin="10,0" Click="PlayPause_Click"
                                ToolTip="Play / pause">
                            <TextBlock x:Name="PlayPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE768;"
                                       FontSize="15"/>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Click="Next_Click"
                                ToolTip="Next">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="13"/>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="VolumeGroup" Grid.Row="3" Margin="0,2,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" Width="22" Height="18"
                                Click="Mute_Click" ToolTip="Mute">
                            <TextBlock x:Name="MuteGlyph" Style="{StaticResource Glyph}" Text="&#xE767;"
                                       FontSize="11"/>
                        </Button>
                        <Button x:Name="QuietButton" Grid.Column="1" Style="{StaticResource TransportButton}"
                                Width="22" Height="18" Margin="2,0,6,0" Click="Quiet_Click" ToolTip="Quiet (10%)">
                            <TextBlock x:Name="QuietGlyph" Style="{StaticResource Glyph}" Text="&#xE993;" FontSize="11"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="2" Style="{StaticResource VolSlider}"
                                Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    </Grid>

                    <Grid x:Name="ProgressHit" Grid.Row="4" Height="12" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="Progress_MouseLeftButtonDown">
                        <Border Height="3.5" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="ProgressFill" Height="3.5" CornerRadius="2"
                                Background="{StaticResource Accent}" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </Grid>
            </Grid>

            <Button x:Name="StreamsButton" Style="{StaticResource CornerButton}" Width="20" Height="20"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                    Click="StreamsButton_Click" ToolTip="Streams and sources">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9"
                           Foreground="{StaticResource TextSecondary}"/>
            </Button>

            <Button x:Name="VideoButton" Style="{StaticResource CornerButton}" Width="20" Height="20"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,6,0,0"
                    Click="VideoButton_Click"
                    ToolTip="Player - open sites here and they follow you across desktops">
                <TextBlock x:Name="VideoGlyph" Style="{StaticResource Glyph}" Text="&#xE714;" FontSize="10"
                           Foreground="{StaticResource TextSecondary}"/>
            </Button>

            <Button x:Name="MixerButton" Style="{StaticResource CornerButton}" Width="20" Height="20"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,6,0,0"
                    Click="MixerButton_Click"
                    ToolTip="Mixer - volume for every app, up to 300%">
                <TextBlock x:Name="MixerGlyph" Style="{StaticResource Glyph}" Text="&#xE9E9;" FontSize="10"
                           Foreground="{StaticResource TextSecondary}"/>
            </Button>

            <Button x:Name="CloseButton" Style="{StaticResource CornerButton}" Width="20" Height="20"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                    Click="Exit_Click" ToolTip="Close">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="8"
                           Foreground="{StaticResource TextSecondary}"/>
            </Button>
        </Grid>
    </Border>
</Window>
