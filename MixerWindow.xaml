<Window x:Class="PlayMe.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayMe mixer" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F3F7"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9DA2B4"/>
        <SolidColorBrush x:Key="Accent" Color="#3BC8D6"/>
        <SolidColorBrush x:Key="Boost" Color="#F5A524"/>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="14" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                    Background="{Binding BarBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Height="14" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="10" Height="10" Fill="#F2F3F7"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MixSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="3" CornerRadius="1.5" Background="#2EFFFFFF"
                                    VerticalAlignment="Center"/>
                            <!-- where 100% sits on a 0-300 track -->
                            <Grid Visibility="{Binding UnityTickVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="1" Height="9" Background="#55FFFFFF"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}"
                                                  Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRest}"
                                                  Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PeakBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#16FFFFFF" CornerRadius="1"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1"
                                    Background="{Binding BarBrush}" Opacity="0.75"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" CornerRadius="14" Background="#F7191A21"
            BorderBrush="#28FFFFFF" BorderThickness="1" Margin="8"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Mixer" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton" Style="{StaticResource IconButton}"
                            Click="Reset_Click" ToolTip="Put every app back to 100%">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" FontSize="11"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                            Click="Close_Click" ToolTip="Hide the mixer">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="42" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="20" Height="20"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               Visibility="{Binding GlyphVisibility}"/>
                                </Grid>

                                <Grid Grid.Column="1" Margin="4,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="11"
                                               Foreground="{Binding NameBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}"/>
                                    <Slider Grid.Row="1" Style="{StaticResource MixSlider}"
                                            Minimum="0" Maximum="{Binding Maximum}"
                                            Value="{Binding Percent, Mode=TwoWay}"
                                            ToolTip="{Binding SliderTip}"
                                            Margin="0,3,0,2"/>
                                    <ProgressBar Grid.Row="2" Style="{StaticResource PeakBar}"
                                                 Value="{Binding Peak}"/>
                                </Grid>

                                <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="11"
                                           Foreground="{Binding PercentBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,4,0"/>

                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="22"
                                        Click="Mute_Click" Tag="{Binding Key}"
                                        ToolTip="{Binding MuteTip}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MuteGlyph}"
                                               FontSize="11" Foreground="{Binding MuteBrush}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
